# ---- Database ----
# Matches docker-compose.yml (pnpm db:up). Only change it if Postgres runs somewhere else.
DATABASE_URL=postgres://es:es@localhost:5432/expert_sessions

# ---- WhatsApp (from Meta developer app -> WhatsApp -> API Setup) ----
WHATSAPP_TOKEN=paste_the_access_token_here
WHATSAPP_PHONE_NUMBER_ID=paste_the_phone_number_id_here
# A password you invent. Paste the same value into Meta's "Verify token" box.
WHATSAPP_VERIFY_TOKEN=expert-sessions-verify-2026
# The test number as Meta shows it, digits only (e.g. 15550001234). pnpm seed puts it on Guruji's
# row so messages sent to that number reach him. Change it later in the console Settings.
WHATSAPP_DISPLAY_NUMBER=15550001234

# ---- Razorpay (Dashboard -> Settings -> API Keys, in TEST mode) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Dashboard -> Settings -> Webhooks -> the secret you set when adding the webhook
RAZORPAY_WEBHOOK_SECRET=another-password-you-invent

# ---- Her sign-in on his website (phone + code; no accounts, no passwords) ----
# Any long random string. Changing it signs every devotee out.
DEVOTEE_SESSION_SECRET=change-me-to-a-long-random-string
# The code she is asked for. Mock until an SMS provider is wired; leave unset for 1234.
# OTP_CODE=1234

# ---- Video room (100ms dashboard -> Developer -> App credentials; and a template to make rooms from) ----
HMS_ACCESS_KEY=
HMS_SECRET=
HMS_TEMPLATE_ID=
# The role names in that template. Guruji is the host; she is the guest.
# HMS_ROLE_GURU=host
# HMS_ROLE_DEVOTEE=guest

# ---- Guruji's own screens (one magic link for the pilot; no password) ----
# Any long random string. His link is {web}/guru?t=<this>.
GURU_MAGIC_TOKEN=

# ---- Where her "Join session" link points ----
# Normally his own domain, from the console's Settings. Set this while the pilot runs on
# ngrok or localhost, where his domain resolves nowhere. No trailing slash.
# JOIN_LINK_BASE=http://localhost:5173

# ---- This server ----
PORT=3000
# The public https address of this server (ngrok URL this week). No trailing slash.
APP_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
# Where the web app is served from in dev; Socket.IO accepts connections from here.
WEB_ORIGIN=http://localhost:5173

# ---- Team console (one shared login, no accounts) ----
CONSOLE_USER=team
CONSOLE_PASSWORD=choose-a-password
# Which guru this console manages (his slug). One guru per console login for the pilot.
CONSOLE_GURU_SLUG=guruji
