# Copy to deploy/.env and fill in. This one file feeds docker compose AND the app container.
# Never commit deploy/.env. Generate long random values with:  openssl rand -hex 32

# ---- Where this runs ----
# The platform's public hostname. An A record for it must point at this server, and ports 80 and
# 443 must be reachable from the internet (Meta and Razorpay call us). No scheme, no slash.
PUBLIC_HOST=sessions.example.com
# Where Let's Encrypt sends certificate notices.
ACME_EMAIL=ops@example.com
# The public https address, derived from PUBLIC_HOST. No trailing slash.
APP_BASE_URL=https://sessions.example.com
WEB_ORIGIN=https://sessions.example.com
# Older addresses that must keep working after PUBLIC_HOST changes (comma-separated, no scheme):
# Meta and Razorpay keep calling the address they were given until someone updates them there.
EXTRA_HOSTS=
# Leave JOIN_LINK_BASE unset in production: her link uses his own domain when the console has one,
# otherwise APP_BASE_URL.
# JOIN_LINK_BASE=

# ---- Postgres (the db container; DATABASE_URL is composed from this in docker-compose.yml) ----
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32

# ---- WhatsApp (Meta developer app -> WhatsApp -> API Setup; use the permanent System User token) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app → App settings → Basic → App secret. Set it: without it the webhook accepts unsigned posts.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=

# ---- Secrets at rest ----
# Encrypts what gurus hand us (their Razorpay secrets). 32 random bytes in hex: openssl rand -hex 32.
# Changing it makes every stored secret unreadable, so keep it with the backups.
SECRETS_KEY=

# ---- Razorpay (Dashboard -> Settings -> API Keys; webhook secret from Settings -> Webhooks) ----
# The platform's own account. A guru with his own account connected in the console uses his keys instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- 100ms (Developer -> App credentials; the template rooms are made from) ----
HMS_ACCESS_KEY=
HMS_SECRET=
HMS_TEMPLATE_ID=

# ---- Sign-ins ----
# Everyone signs in to the console with their WhatsApp number and a password (first password and
# resets through a code on WhatsApp). CONSOLE_USER / CONSOLE_PASSWORD stay as the admin's break-glass door.
CONSOLE_USER=team
CONSOLE_PASSWORD=
# Signs the console cookie; falls back to CONSOLE_PASSWORD when unset. Change it to sign everyone out.
CONSOLE_SESSION_SECRET=
# The first Slike admin, created on boot if no admin exists yet. Digits with the country code.
ADMIN_PHONE=
ADMIN_NAME=
CONSOLE_GURU_SLUG=guruji
GURU_MAGIC_TOKEN=
DEVOTEE_SESSION_SECRET=
# Her sign-in code on his website; mock until an SMS provider is wired.
OTP_CODE=1234

# ---- Being told when it stops ----
# A heartbeat URL from Healthchecks.io / Better Stack / Cronitor. The api pings it every minute
# after checking Postgres; the service alerts whoever is on call when the pings stop.
HEARTBEAT_URL=
