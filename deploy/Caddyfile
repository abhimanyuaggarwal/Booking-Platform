# Public https in front of the api. Two kinds of hostname:
#   PUBLIC_HOST            the platform's own address (console, guruji's screens, /s/<slug> previews,
#                          both provider webhooks). Certificate issued at start.
#   a guru's own domain    his team adds one CNAME to PUBLIC_HOST and types the domain into the
#                          console's Settings. Caddy asks the api (/api/tls-ask) whether it knows
#                          the domain and, if so, issues a certificate on the first visit.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/tls-ask
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip
	reverse_proxy app:3000
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000
}
